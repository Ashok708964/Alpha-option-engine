# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# Zerodha Kite Connect 3.0 API Credentials (Optional)
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# Angel One SmartAPI Credentials (FREE for retail users)
ANGEL_API_KEY=
ANGEL_CLIENT_CODE=
ANGEL_PIN=
ANGEL_TOTP_SECRET=
ANGEL_FEED_TOKEN=

# Terminal Security & Owner Email Authorization Gate
AUTHORIZED_OWNER_EMAIL=
TERMINAL_ACCESS_PIN=

# Cross-Origin Resource Sharing (CORS) for Azure VM Backend
# Set to your Cloudflare Pages domain, e.g. https://apex-stratos.pages.dev
CORS_ORIGIN=

# Frontend API Target (Set on Cloudflare Pages environment variables)
# If left blank, defaults to current host (same-origin)
VITE_API_BASE_URL=

# AWS Backend & DynamoDB Configuration (For AWS EC2 / App Runner)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DYNAMODB_TBT_TABLE=tbt_market_ticks
DYNAMODB_TRADES_TABLE=trade_ledger
DYNAMODB_LOGS_TABLE=algo_audit_logs

# Azure Cosmos DB Ingestion Pipeline & TBT Recorder (Optional)
AZURE_COSMOS_ENDPOINT=
AZURE_COSMOS_KEY=
AZURE_COSMOS_DATABASE_ID=apex_quant_db
AZURE_COSMOS_TBT_CONTAINER=tbt_market_ticks
AZURE_COSMOS_TRADES_CONTAINER=trade_ledger
AZURE_COSMOS_LOGS_CONTAINER=algo_audit_logs
